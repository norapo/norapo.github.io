#!/bin/sh
# partials の同期漏れを防ぐ: 差分が出たら同期したうえでコミットを止める
set -e
cd "$(git rev-parse --show-toplevel)"
out="$(python3 scripts/sync-partials.py)"
case "$out" in
  *"(差分なし)"*) ;;
  *)
    echo "$out" >&2
    echo "pre-commit: partials が未同期だったため同期しました。変更を確認して git add し、再コミットしてください。" >&2
    exit 1
    ;;
esac
