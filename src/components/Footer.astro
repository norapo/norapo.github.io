---
interface Props {
  root: string;
  current?: 'support' | 'privacy' | 'feedback' | 'donate';
}
const { root, current } = Astro.props;
---
<footer>
  <div class="wrap">
    <a href={`${root}support/`} aria-current={current === 'support' ? 'page' : undefined}>よくある質問</a>
    <a href={`${root}privacy/`} aria-current={current === 'privacy' ? 'page' : undefined}>プライバシーポリシー</a>
    <a href={`${root}feedback/`} aria-current={current === 'feedback' ? 'page' : undefined}>フィードバック</a>
    <a href={`${root}donate/`} aria-current={current === 'donate' ? 'page' : undefined}>開発者を支援する</a>
    <span class="copyright">© 2026 Norapo</span>
  </div>
</footer>
